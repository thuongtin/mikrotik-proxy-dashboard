# Dashboard Authentication
# Generate hash using: ./proxy-dash --hash-password
DASHBOARD_PASSWORD_HASH=$2a$10$exampleexampleexampleexampleexampleexampleexampleexamp

# MikroTik RouterOS v7 REST API
# The host in MIKROTIK_URL must appear in the router certificate (SAN).
MIKROTIK_URL=https://10.88.88.1
# Use a dedicated low-privilege account, not the built-in admin.
MIKROTIK_USER=proxy-dash
MIKROTIK_PASS=change-me-to-your-router-password
# TLS verification is ON by default. Point this at the PEM of the CA
# (or of the self-signed certificate) used by the router's www-ssl service.
MIKROTIK_CA_FILE=/data/router-ca.pem
# Temporary escape hatch only: disables certificate verification entirely.
# MIKROTIK_INSECURE_TLS=true

# Network & Routing
LISTEN_ADDR=:8080
DATA_DIR=/data
LAN_CIDR=10.88.88.0/24
CONTAINER_GW=10.10.10.1
# VETH_IF=veth-proxy
EXCLUDE_CIDRS=10.88.88.0/24,10.10.10.0/24,10.77.77.0/24,192.168.0.0/16

# Forward guard inside the container (read by entrypoint.sh):
#   auto    - install the guard; if the kernel refuses, warn and keep running
#   enforce - install the guard; if the kernel refuses, exit instead of starting
#   off     - do not install the guard
FORWARD_GUARD=auto

# Engine
SINGBOX_PATH=/usr/local/bin/sing-box
