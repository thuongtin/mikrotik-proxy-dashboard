# Dashboard Authentication
# Generate hash using: ./proxy-dash --hash-password
DASHBOARD_PASSWORD_HASH=$2a$10$exampleexampleexampleexampleexampleexampleexampleexamp

# MikroTik RouterOS v7 REST API
MIKROTIK_URL=https://10.88.88.1
MIKROTIK_USER=admin
MIKROTIK_PASS=change-me-to-your-router-password
MIKROTIK_INSECURE_TLS=true

# Network & Routing
LISTEN_ADDR=:8080
DATA_DIR=/data
LAN_CIDR=10.88.88.0/24
CONTAINER_GW=10.10.10.1
# VETH_IF=veth-proxy
EXCLUDE_CIDRS=10.88.88.0/24,10.10.10.0/24,10.77.77.0/24,192.168.0.0/16

# Engine
SINGBOX_PATH=/usr/local/bin/sing-box
